# Application
APP_NAME=Digital Twin API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database
# ---------------------------------------------------------------------------
# TARGET MATRIX (Phase 14 / DB safety):
#   FastAPI           reads backend/.env         -> the single runtime DATABASE_URL
#   MQTT subscriber   reads backend/.env         -> MUST equal FastAPI's target
#   simulator         reads backend/.env (MQTT_* only; it never touches the DB)
#   migration cmd     reads backend/.env         (`alembic upgrade head` in backend/)
#   Next.js           reads frontend/.env.local   (BACKEND_API_URL = FastAPI base)
#
# The normal runtime stack must consistently use ONE database target. The
# committed backend/.env points at Supabase for runtime; a local PostgreSQL
# (e.g. digital_twin_rt) is only for isolated experiments and MUST NOT be the
# target of the running stack. Destructive local tooling refuses non-local
# targets (see scripts/reset_local_db.py and app/core/db_target.py).
#
# Default local/Compose URL. For Supabase (Phase 3.5), paste the exact string
# from Dashboard > Project Settings > Database > Connect dialogue and swap it
# in below; SSL/TLS is driven purely by the URL. Use `?ssl=require` (the
# asyncpg dialect accepts `ssl` as a connect argument; Supabase requires TLS
# and asyncpg also negotiates it automatically when the parameter is absent).
# Prefer the DIRECT connection (db.<ref>.supabase.co:5432); fall back to the
# SESSION pooler (Port 5432) only when the network is IPv4-only. Do not pick
# transaction mode. Never commit the real URL with credentials.
#DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/digital_twin

# CORS - JSON array of allowed origins (development default)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# ---------------------------------------------------------------------------
# MQTT broker + subscriber (Phase 2)
# Local development defaults: anonymous local broker on 127.0.0.1:1883.
# With `docker compose up` the broker requires MQTT_USERNAME/MQTT_PASSWORD
# (Compose defaults to mqtt/mqtt - dev-only, override in .env).
# ---------------------------------------------------------------------------
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Leave MQTT_CLIENT_ID unset to get a unique per-process id (two processes
# sharing one id trigger MQTT session takeover and crash the subscriber on
# Windows). Set it explicitly only when a stable id is required.
#MQTT_CLIENT_ID=my-stable-client-id
MQTT_QOS=1
MQTT_TOPIC_PREFIX=vehicles
MQTT_KEEPALIVE=60
MQTT_RECONNECT_MAX_SECONDS=30
MQTT_MESSAGE_RETRY_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Vehicle simulator (Phase 2)
# REQUIRED: the simulator refuses to start without SIMULATOR_VEHICLE_ID.
# `make seed-demo-vehicle` creates the vehicle with this fixed id.
# ---------------------------------------------------------------------------
SIMULATOR_VEHICLE_ID=43f54f26-0985-435d-acb6-3c0c3004a20a
SIMULATOR_INTERVAL_SECONDS=1.0
SIMULATOR_SCENARIO=normal        # normal | high_temperature | low_battery | high_engine_load
SIMULATOR_SEED=42
SIMULATOR_CRUISE_SPEED=60.0

# ---------------------------------------------------------------------------
# Vehicle health intelligence (Phase 3)
# ---------------------------------------------------------------------------
HEALTH_ANALYSIS_WINDOW_MINUTES=15        # default telemetry analysis window
HEALTH_MINIMUM_SAMPLES=10                # minimum samples for a confident assessment
HEALTH_EXPECTED_INTERVAL_SECONDS=1.0     # expected telemetry interval (gap estimation)
HEALTH_BASELINE_WINDOW_MINUTES=360       # historical telemetry used for baselines
HEALTH_BASELINE_MINIMUM_SAMPLES=5        # minimum history samples for a baseline comparison

# ---------------------------------------------------------------------------
# Agentic vehicle reasoning (Phase 4) — LLM providers
# Primary is tried first; on retryable/auth/config failures the fallback is
# used (built lazily, skipped when not configured). Leave keys empty to run
# everything except the LLM-calling endpoints; tests use MockLLMProvider.
# ---------------------------------------------------------------------------
LLM_PRIMARY_PROVIDER=openrouter
LLM_FALLBACK_PROVIDER=groq
#OPENROUTER_API_KEY=
#OPENROUTER_MODEL=openai/gpt-4o-mini
#GROQ_API_KEY=
#GROQ_MODEL=llama-3.3-70b-versatile
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1500
LLM_CONTEXT_MAX_CHARS=24000
# Repeated critical telemetry for the same vehicle/rule set is de-duplicated
# for at least this many seconds (no extra LLM call).
AGENT_CRITICAL_EVENT_COOLDOWN_SECONDS=300

# Live LLM smoke test requires an explicit opt-in (see `make agent-llm-smoke`).
#RUN_LLM_SMOKE_TEST=true

# ---------------------------------------------------------------------------
# Identity, roles & vehicle ownership (Phase 6) — JWT + refresh tokens
# REQUIRED: the API fails at startup if JWT_SECRET is missing/short (<32 chars).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET must never be committed; keep it in .env only.
#JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_MINUTES=20
AUTH_REFRESH_TOKEN_DAYS=30

# ---------------------------------------------------------------------------
# RAG / retrieval (Phase 5) + admin uploads (Phase 6.x)
# All fields live on RAGSettings (app/rag/config.py) and take the RAG_* prefix.
# RAG_ENABLED is the only behavioural gate; every other field has a documented
# default so a bare instance is always usable for offline evaluation without an
# active corpus. Complex values (RAG_DOCUMENT_ROOTS) use JSON syntax.
# ---------------------------------------------------------------------------
RAG_ENABLED=true
RAG_EMBEDDING_MODEL=BAAI/bge-m3
# The embedding dimension is fixed by the pgvector column declaration (1024) -
# do not change it unless you also migrate the schema.
#RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_DEVICE=auto
RAG_EMBEDDING_BATCH_SIZE=16
RAG_EMBEDDING_MAX_LENGTH=1024
RAG_EMBEDDING_NORMALIZE=true
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANKER_DEVICE=auto
RAG_RERANKER_MAX_LENGTH=512
# Chunking
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
# Retrieval (retrieval_top_k candidates fetched -> rerank_top_k reranked ->
# final_top_k returned)
RAG_RETRIEVAL_TOP_K=25
RAG_RERANK_TOP_K=30
RAG_FINAL_TOP_K=5
RAG_HYBRID_ALPHA=0.6
RAG_MIN_RERANK_SCORE=0.2
RAG_MIN_SCORE=0.0
# Ingestion limits / safety
RAG_MAX_DOCUMENT_BYTES=52428800
RAG_MAX_DOCUMENT_PAGES=2000
RAG_MAX_CHUNKS=20000
# Document corpus roots (JSON array of paths)
#RAG_DOCUMENT_ROOTS=["data/documents"]
# Query / evidence bounds
RAG_QUERY_MAX_CHARS=500
RAG_EVIDENCE_MAX_CHARS=1800
# Admin upload ceiling (POST /api/v1/admin/rag/documents): hard limit for a
# single multipart upload - 413 returned before the file is written to disk.
# Independent of RAG_MAX_DOCUMENT_BYTES; the parser registry (not this value)
# decides which extensions are accepted.
RAG_MAX_UPLOAD_SIZE_MB=50

# ---------------------------------------------------------------------------
# SIMULATION_* (Simulation Control)
# Per-vehicle simulator subprocesses are supervised by the API
# (SimulationManager). These knobs bound process lifecycle; they do not select
# scenario/interval/seed — that is per-request via
# POST /api/v1/vehicles/{id}/simulation. RUNTIME_DIR holds the marker files
# that let the API detect and clean up orphaned simulator processes.
# ---------------------------------------------------------------------------
SIMULATION_STARTUP_GRACE_SECONDS=3.0   # how long a fresh spawn may run before being eligible for supervise-stop
SIMULATION_STOP_TIMEOUT_SECONDS=5.0    # graceful SIGTERM grace before SIGKILL escalation
#SIMULATION_RUNTIME_DIR=/var/tmp/dtwin-simulations   # defaults to <system temp>/dtwin-simulations