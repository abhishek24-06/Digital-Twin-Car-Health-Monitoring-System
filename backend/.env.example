# Application
APP_NAME=Digital Twin API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database (Docker Compose default; adjust host/name for local dev)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/digital_twin

# CORS - JSON array of allowed origins (development default)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]