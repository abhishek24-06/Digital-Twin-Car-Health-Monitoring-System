# Base URL of the Digital Twin FastAPI backend (server-side only, never exposed to the browser).
# The Next.js session proxy (src/app/api/session/*) calls the backend through this value.
BACKEND_API_URL=http://localhost:8000/api/v1

# Base URL used by the browser for data requests. Defaults to http://localhost:8000/api/v1
# when unset. The backend must list this app's origin in CORS_ORIGINS (localhost:3000 by default).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1